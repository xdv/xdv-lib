//   xdv-lib top-level forge.

forge XdvLib {

    const ABI_REVISION: UInt32 = 1;

    proc K::init() -> UInt32 {
        emit "xdv-lib initialized";
        return ABI_REVISION;
    }

    proc K::xdv_boot_prepare(seconds: UInt32) -> UInt32 {
        let wait = xdv_boot_splash_wait_seconds(seconds);
        if wait == 0 {
            let clear = xdv_boot_console_clear();
            if clear == 0 {
                return 0;
            } else {
                return clear;
            }
        } else {
            return wait;
        }
    }

    proc K::xdv_boot_transfer_kernel() -> UInt32 {
        return xdv_boot_kernel_handoff();
    }
}